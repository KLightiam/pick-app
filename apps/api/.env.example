# With NODE_ENV=production the API refuses to start until everything below is set for real (see docs/launch-checklist.md)
PORT=4000
DATABASE_URL=postgres://pick:pick@localhost:5433/pick
# Websites allowed to call the API, comma-separated: the web app and the admin dashboard
CORS_ORIGIN=http://localhost:8081,http://localhost:5173
# In production: a long random secret, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# console prints sign-in codes to the terminal; twilio sends real SMS
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=Pick
# Road routes for commuters: osrm (open source) or straight (straight lines, for testing)
ROUTING_PROVIDER=osrm
# The public demo server is for development only; run your own OSRM in production
OSRM_URL=https://router.project-osrm.org
# Address search (Photon, open source). The public server is for development only
GEOCODER_URL=https://photon.komoot.io
# Where phones and Paystack/Stripe reach this API (payment return page)
PUBLIC_URL=http://localhost:4000
# Payments. Leave the keys empty in development to use a test checkout page instead
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_EMAIL_DOMAIN=riders.pick.invalid
# Driver payouts run every week by themselves; set to off to pay only when an admin presses Pay now
AUTO_PAYOUTS=on
# Driver documents. Leave S3_BUCKET empty in development to keep uploads in apps/api/uploads
S3_BUCKET=
S3_REGION=auto
# For Cloudflare R2, MinIO and other S3-compatible stores; empty for AWS
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Push notifications go through Expo. Set to off to turn them off; EXPO_ACCESS_TOKEN only if Expo's enhanced push security is on
PUSH_NOTIFICATIONS=on
EXPO_ACCESS_TOKEN=
